{
  "display_information": {
    "name": "coocoo",
    "description": "슬랙에서 대화로 cc-os를 개발하는 AI 봇",
    "background_color": "#1f6feb"
  },
  "features": {
    "bot_user": {
      "display_name": "coocoo",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write",
        "channels:history",
        "groups:history"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["app_mention"]
    },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
