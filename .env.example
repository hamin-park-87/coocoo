# coocoo 환경변수 (.env 로 복사 후 값 채우기) — Railway에서는 Variables 에 등록
# ⚠️ .env 는 git 커밋 금지. 비밀키는 비밀번호 매니저로 공유.

# ── Slack (Socket Mode) ──
SLACK_BOT_TOKEN=            # xoxb- (봇 토큰: 메시지 게시·읽기)
SLACK_APP_TOKEN=            # xapp- (Socket Mode 앱 레벨 토큰, connections:write)

# ── Claude (Agent SDK) ──
ANTHROPIC_API_KEY=          # Anthropic API 키 (cc-os 와 별개 키 권장)
COOCOO_MODEL=sonnet         # 코딩용 모델 (sonnet 권장 / opus 가능)

# ── GitHub (PR 생성) ──
GITHUB_TOKEN=               # repo 권한 PAT (contents+pull_requests). coocoo 전용 토큰 권장
REPO_URL=https://github.com/hamin-park-87/cc-os
BASE_BRANCH=main
# 작업용 클론 위치(Railway 컨테이너 내부 경로)
REPO_DIR=/app/workspace/cc-os

# ── 접근 제한(선택) ──
# 봇을 호출할 수 있는 슬랙 채널 ID 화이트리스트(쉼표구분). 비우면 모든 채널 허용.
ALLOWED_CHANNELS=
# 호출 허용 슬랙 유저 ID(쉼표구분). 비우면 모두 허용.
ALLOWED_USERS=
